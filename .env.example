# Copia este fichero a .env y rellena los valores. .env no se sube a git.

# --- Servidor ---
PORT=8080
HOST=0.0.0.0
# Token que usa la app Android (minimo 12 caracteres). Lo ve el log de auditoria como "actor" via PRAXON_USER.
PRAXON_TOKEN=
PRAXON_USER=alex
ASSISTANT_NAME=Praxon

# --- Modelo ---
# scripted = modelo guionizado para pruebas, sin gastar API. anthropic = modelo real.
MODEL_PROVIDER=scripted
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-5-5
MAX_TOKENS=1024

# --- Voz de las respuestas (opcional) ---
# none = la app lee las respuestas con la voz de Android. elevenlabs = voz de ElevenLabs.
# Privacidad: con elevenlabs, el texto de cada respuesta (titulos de tickets, nombres...) sale hacia ElevenLabs.
# El reconocimiento de voz (lo que dices) sigue en el movil. Si ElevenLabs falla, la app usa la voz de Android.
VOICE_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE=es
# Residencia de datos en la UE (solo Enterprise, otra cuenta y otra clave): https://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- MyRAYPA ---
# fake = datos de ejemplo en memoria. http = API real de MyRAYPA (credencial propia de permisos acotados).
MYRAYPA_MODE=fake
MYRAYPA_API_URL=
MYRAYPA_API_TOKEN=

# --- GitHub (lanzar agentes) ---
# fake = no llama a GitHub. http = dispara el workflow del repo (token de grano fino, solo Actions: write en esos repos).
GITHUB_MODE=fake
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=praxon-agent.yml

# --- Limites ---
CONFIRM_TTL_MS=60000
MAX_TOOL_ITERATIONS=6
MAX_HISTORY_MESSAGES=40
AUDIT_LOG_PATH=./logs/audit.jsonl
