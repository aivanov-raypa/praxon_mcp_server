# Plantilla de configuración del servidor de Praxon. Se copia a .env (permisos 600) y se rellena EN EL SERVIDOR.
# El .env no se versiona. No pegues nunca estos valores en chats, tickets ni commits.
# Las variables con valor vacío hay que rellenarlas; las comentadas (#) son opcionales.

# ---------- Servidor ----------
PORT=8080
# Escucha en todas las interfaces; el acceso se limita a la red interna con el cortafuegos (ufw) que deja setup-server.sh.
HOST=0.0.0.0
# Mínimo 12 caracteres. setup-server.sh lo genera solo. Con ALLOW_LEGACY_TOKEN=false los móviles se emparejan desde MyRAYPA.
PRAXON_TOKEN=
ALLOW_LEGACY_TOKEN=false
PRAXON_USER=desconocido
# Dirección que ven los móviles (ws:// mientras no haya TLS).
PRAXON_PUBLIC_URL=ws://IP_INTERNA_DEL_SERVIDOR:8080/ws
ASSISTANT_NAME=Praxon

# ---------- Modelo (Anthropic) ----------
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-5-5
TRIAGE_MODEL=claude-sonnet-5-5

# ---------- MyRAYPA ----------
# Producción: la URL interna de MyRAYPA. Pruebas: http://127.0.0.1:4000/api (MyRAYPA de test en esta misma máquina).
MYRAYPA_MODE=http
MYRAYPA_API_URL=
# Debe coincidir con ASSISTANT_API_TOKEN del .env de MyRAYPA.
MYRAYPA_API_TOKEN=

# ---------- GitHub ----------
GITHUB_MODE=http
GITHUB_ORG=
GITHUB_WORKFLOW_FILE=praxon-agent.yml
# Token de grano fino, solo lectura (Contents, Pull requests, Metadata, Actions, Checks, Commit statuses).
GITHUB_READ_TOKEN=
# Token de grano fino para lanzar el workflow de los agentes.
GITHUB_TOKEN=
# Token de grano fino PROPIO para fusionar (Pull requests y Contents en escritura).
GITHUB_MERGE_TOKEN=
GITHUB_MERGE_METHOD=squash
# Ramas donde Praxon puede fusionar. Nunca main.
MERGE_ALLOWED_BASES=develop
# Logins de GitHub (separados por comas) autorizados a pulsar "fusionar" desde la app.
MERGE_ALLOWED_USERS=

# ---------- Seguridad y gasto ----------
PAUSE_PATH=./data/pausa.json
BUDGET_DAILY_EUR=5
BUDGET_TRIAGE_DAILY_EUR=1.5
ATTACH_CONFIRM_KB=300

# ---------- Revisión automática de tickets ----------
# Déjala en false hasta haber probado Praxon en la conversación; actívala después.
TRIAGE_ENABLED=false
TRIAGE_TIMES=08:30
# Fecha de corte para que NO revise el backlog antiguo (ISO, por ejemplo 2026-11-02T00:00:00Z).
# TRIAGE_WATCH_FROM=

# ---------- Google (calendario y correo, solo lectura; ver docs/google.md) ----------
GOOGLE_MODE=off
# GOOGLE_OWNER_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ---------- Voz (opcional) ----------
VOICE_PROVIDER=none
STT_PROVIDER=none
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
